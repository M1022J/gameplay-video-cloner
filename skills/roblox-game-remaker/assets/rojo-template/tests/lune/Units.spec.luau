local T = require("./T")
local Units = require("../../src/shared/Remake/Units")

T.describe("Units", function()
	T.it("converts meters and studs with the official 0.28 m stud", function()
		T.near(Units.studsFromMeters(1.8), 6.428571, 1e-5)
		T.near(Units.metersFromStuds(10), 2.8, 1e-9)
		T.near(Units.studsFromMeters(2, 2.5), 5, 1e-12)
	end)
	T.it("converts horizontal FOV to Roblox vertical FOV", function()
		T.near(Units.verticalFromHorizontalFov(90, 16 / 9), 58.7155, 1e-3)
		T.near(Units.horizontalFromVerticalFov(70, 16 / 9), 102.4479, 1e-3)
	end)
	T.it("round-trips FOV conversions", function()
		local v = Units.verticalFromHorizontalFov(103, 21 / 9)
		T.near(Units.horizontalFromVerticalFov(v, 21 / 9), 103, 1e-9)
	end)
	T.it("solves asymmetric jumps like remake_calc.py", function()
		local j = Units.solveJump(7.4, 0.383, 0.3)
		T.near(j.takeoffSpeed, 38.6423, 1e-3)
		T.near(j.riseGravity, 100.8937, 1e-3)
		T.near(j.fallGravity, 164.4444, 1e-3)
		T.near(j.fallMultiplier, 1.6299, 1e-3)
		T.near(j.airtime, 0.683, 1e-9)
	end)
	T.it("relates jump height and speed", function()
		T.near(Units.jumpHeightFromSpeed(50, 196.2), 6.3710, 1e-3)
		T.near(Units.jumpSpeedFromHeight(7.2, 196.2), 53.1534, 1e-3)
	end)
	T.it("converts frames", function()
		T.near(Units.secondsFromFrames(23, 60), 0.38333, 1e-4)
		T.near(Units.framesFromSeconds(0.5, 30), 15, 1e-12)
		T.throws(function()
			Units.secondsFromFrames(1, 0)
		end)
	end)
end)

return nil
